; Arquivo de configuração do projeto Godot.
; Aqui ficam o nome do jogo, a cena principal e o mapa de teclas (Input Map).
; Você normalmente edita isso pela interface do Godot, mas dá para ler/editar à mão.

config_version=5

[application]

config/name="Vampire Prototype"
config/description="Protótipo de mini mundo aberto dark fantasy: um vampiro que vira morcego."
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"

